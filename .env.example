# =============================================================================
#  .env — as duas chaves que o SISTEMA precisa para subir
# =============================================================================
#
#  Copie este arquivo e preencha os dois valores (na instalação, quem copia é
#  a IA da IDE, e você só cola — ver a parte 2 do INSTALACAO.md):
#
#      cp .env.example .env
#      npm run instalar:conferir     ← diz se cada linha está certa, sem mostrar valor
#
#  VIDA ÚTIL: permanente. O `npm run dev` lê ele toda vez que sobe.
#             No deploy, as MESMAS duas variáveis são cadastradas no painel da
#             Vercel (Settings -> Environment Variables) — o `.env` não sobe
#             junto, porque está no `.gitignore`.
#
#  ⚠️  Variável faltando NÃO quebra o build. O Vite embute `undefined` e a tela
#      fica branca no primeiro acesso ao banco — sem erro nenhum no terminal.
#
#  ⚠️  O Vite embute em tempo de BUILD. Mudou uma variável, reimplante.
#
# =============================================================================


# Painel do Supabase -> Settings -> API Keys -> campo "Project URL"
# Formato: https://SEU_PROJECT_REF.supabase.co
VITE_SUPABASE_URL=


# Painel do Supabase -> Settings -> API Keys -> a chave PÚBLICA: a `anon` /
# `public` (começa com eyJ) ou, nos projetos novos, a `publishable`
# (começa com sb_publishable_). As duas servem.
#
# ⚠️  NUNCA use a secreta aqui — a `service_role`, ou a `sb_secret_`. Este
#     arquivo vira JavaScript entregue ao navegador: a chave fica visível para
#     qualquer visitante. A pública é protegida pelo RLS; a secreta ignora o
#     RLS inteiro. O `instalar:conferir` acusa se ela vier parar aqui.
VITE_SUPABASE_ANON_KEY=
